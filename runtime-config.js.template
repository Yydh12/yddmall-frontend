(function () {
  // 运行时注入的前端配置（由 Nginx 启动脚本用 envsubst 生成）
  window.__APP_CONFIG__ = window.__APP_CONFIG__ || {};
  // BASE_API 会被容器环境变量 ${BASE_API} 替换为实际后端地址
  window.__APP_CONFIG__.BASE_API = "${BASE_API}";
  // 兼容 CRA/React 风格的环境变量命名
  window.__APP_CONFIG__.REACT_APP_API_URL = "${REACT_APP_API_URL}";
})();
